# data (raw is large; processed/splits are regenerable)
data/raw/
data/processed/
data/splits/

# python
__pycache__/
*.pyc
.env
.venv/

# editor / IDE
.idea/

# local Claude Code settings (personal permission allowlist, not shared)
.claude/settings.local.json

# run logs (results CSV/JSON under experiments/ are kept)
experiments/*/*.log

# paper/ is not tracked here at all: the LaTeX source lives on Overleaf and on
# disk, and this repo carries only the code, configuration and experiment
# records. This replaces the earlier rules that ignored only the LaTeX build
# artifacts while keeping the source. Note that paper/ still exists in the
# history of commits up to an earlier commit; untracking it does not remove it from there.
paper/
